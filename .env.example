# Admin login used only when style.asp is first created.
KINGKONG_USERNAME=admin
KINGKONG_PASSWORD=replace-with-a-long-random-password

# Keep this outside the application release directory on the VPS.
CUSTOMALBOOM_DATA_DIR=/var/lib/customalboom

# Used by `npm start` or the standalone server.
PORT=3000
HOSTNAME=127.0.0.1
